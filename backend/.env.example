# ===== 服务 =====
HOST=127.0.0.1
PORT=8000

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rag_app
# 应用账号密码（建库建号时设置，可用 python -c "import secrets;print(secrets.token_urlsafe(12))" 生成）
MYSQL_PASSWORD=
# root 密码：仅 scripts/mysql_stop.bat 停库时读取，不入仓库
MYSQL_ROOT_PASSWORD=
MYSQL_DB=rag_kb

# ===== JWT =====
# 生产环境请改成随机长字符串（可用 python -c "import secrets;print(secrets.token_hex(32))" 生成）
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_DAYS=7

# ===== 通义千问 DashScope =====
# 在 https://bailian.console.aliyun.com/ 开通并创建 API Key（新用户有免费额度）
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=qwen3-rerank
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== RAG 参数 =====
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=10
RRF_K=60
RERANK_TOP_N=5
RERANK_SCORE_THRESHOLD=0.1
CONTEXT_HISTORY_ROUNDS=4

# ===== 语义缓存 =====
# 留空表示自动降级为内存缓存（无 Redis 也能跑）
REDIS_URL=
CACHE_TTL_HOURS=24
CACHE_SIMILARITY_THRESHOLD=0.92

# ===== 限流 =====
CHAT_RATE_LIMIT=20/minute

# ===== 管理员种子账号 =====
# 密码不配置时后端拒绝创建种子管理员（seeds.py 会跳过并告警）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
